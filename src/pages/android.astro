---
import Navbar from '../layouts/navbar.jsx';
import Main from '../layouts/main.jsx';
import Footer from '../layouts/footer.jsx';
import '../../main.css'
import { createClient } from '@supabase/supabase-js';
import Aside from '../layouts/aside.jsx';
import AppLoader from '../components/Preloader.jsx';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;
const supabase = supabaseUrl && supabaseKey ? createClient(supabaseUrl, supabaseKey) : null;

const games = async () => {
  if (!supabase) {
    return [];
  }

  const { data, error } = await supabase
    .from('Game')
    .select('*')
    .not('size_for_android', 'is', null);

  if (error) {
    console.error('Error fetching android games:', error);
    return [];
  }
  return data;
};

const androidGames = (await games()) ?? [];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Game Android</title>
  </head>
  <body>
    <AppLoader client:load />

    <div id="main-content" class="invisible">
      <Navbar client:load />

      <div class="mx-auto mt-10 flex w-full justify-center pb-12">
        <div class="grid grid-cols-[minmax(0,1.8fr)_300px] max-[980px]:grid-cols-1 gap-6 items-start w-[min(1180px,calc(100%-36px))] mx-auto">
          <div class="min-w-0 pr-0 min-[1100px]:pr-4">
            <div class="mb-7 flex items-end justify-between gap-4">
              <div>
                <p class="mb-2 text-xs font-bold uppercase tracking-[0.24em] text-pink-300/80">The archive</p>
                <h2 class="m-0 text-[clamp(2.4rem,2.8vw,4rem)] font-extrabold leading-[0.95] tracking-[-0.06em] text-[#f5f5f5]">Game Android</h2>
              </div>
              <span class="hidden rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-xs font-semibold text-zinc-400 sm:inline-flex">{androidGames.length} titles</span>
            </div>
            <Main games={androidGames} />
          </div>
          <Aside />
        </div>
      </div>
      <Footer />
    </div>
  </body>
</html>