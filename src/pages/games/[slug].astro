---
export const prerender = true;

import '../../../main.css';
import { createClient } from "@supabase/supabase-js";
import Navbar from "../../layouts/navbar.jsx";
import Footer from "../../layouts/footer.jsx";

export async function getStaticPaths() {
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;

  if (!supabaseUrl || !supabaseKey) {
    throw new Error("Missing Supabase environment variables: PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_KEY must be set");
  }

  const supabase = createClient(supabaseUrl, supabaseKey);

  try {
    const { data, error } = await supabase
      .from("data_file_download")
      .select("id, name, size, page, link, image, rating, genre");

    if (error || !data) {
      console.error("Error fetching games for static paths:", error);
      return [];
    }

    return data.map((game) => ({
      params: { slug: game.id },
      props: { game },
    }));
  } catch (err) {
    console.error("Failed to fetch static paths:", err);
    return [];
  }
}

const { game } = Astro.props;

const thumbnail = Array.isArray(game.image)
  ? game.image[0]?.img || "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=900&q=80"
  : "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=900&q=80";

const genreList = Array.isArray(game.genre) && game.genre.length
  ? game.genre
  : ["Adventure"];

const ratingText = typeof game.rating === "number" ? game.rating.toFixed(1) : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{game.name} — MegumiTL</title>
</head>
<body class="m-0 flex min-h-screen flex-col justify-between bg-[image:linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[length:42px_42px] text-[#f4f4f5]">
    <Navbar client:load />
  <main class="mx-auto w-full max-w-[1180px] px-4 py-8 sm:px-6 sm:py-12">
    <a href="/home" class="inline-flex items-center gap-2 text-sm font-semibold text-zinc-400 transition-colors hover:text-pink-300">
      <span aria-hidden="true">&#8592;</span>
      Back to games
    </a>

      <div class="mt-6 grid gap-8 overflow-hidden rounded-[24px] border border-white/10 bg-white/[0.045] p-3 shadow-[0_20px_60px_rgba(0,0,0,0.28)] lg:grid-cols-[minmax(0,1.15fr)_minmax(300px,0.85fr)] lg:p-5">
        <div class="relative min-h-[280px] overflow-hidden rounded-[18px] bg-zinc-900 lg:min-h-[460px]">
          <img src={thumbnail} alt={game.name} class="absolute inset-0 h-full w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
          <div class="absolute bottom-5 left-5 right-5">
            <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-pink-300">Game details</p>
            <h1 class="text-3xl font-extrabold leading-tight tracking-[-0.04em] text-white sm:text-4xl">{game.name}</h1>
          </div>
        </div>

        <div class="flex flex-col justify-center px-3 py-5 lg:px-6">
          <div class="flex flex-wrap gap-2">
            {genreList.map((genre: string) => <span class="rounded-md border border-pink-300/15 bg-pink-300/[0.07] px-2.5 py-1 text-xs font-semibold text-pink-100/80">{genre}</span>)}
          </div>
          <dl class="mt-7 grid grid-cols-2 gap-4 border-y border-white/10 py-5">
            <div><dt class="text-xs uppercase tracking-wider text-zinc-500">Size</dt><dd class="mt-1 font-semibold text-zinc-100">{game.size || "Unknown"}</dd></div>
            {ratingText && <div><dt class="text-xs uppercase tracking-wider text-zinc-500">Rating</dt><dd class="mt-1 font-semibold text-zinc-100">★ {ratingText} / 5</dd></div>}
          </dl>
          <p class="mt-6 text-sm leading-6 text-zinc-400">Ready to play? Choose your platform and start the download.</p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
            <a href={game.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-pink-500 px-5 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-pink-950/40 transition hover:bg-pink-400">Windows <span aria-hidden="true">↗</span></a>
            <a href={game.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/[0.06] px-5 py-3.5 text-sm font-extrabold text-white transition hover:border-pink-300/40 hover:bg-pink-300/10">Android <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </main>
    <Footer />
</body>
</html>