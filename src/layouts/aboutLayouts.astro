---
import HeadLayouts from "./headLayouts.astro";
interface Props {
  title?: string;
  description?: string;
}
const { title = "Default Title", description = "Default description" } = Astro.props as Props;
---

   <html lang="en">
     <HeadLayouts title={title} description={description} />
      <body class="site-shell">
       <slot>default content</slot>
       <p>{description}</p>
      </body>
    </html>
